<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            Shared MSTest harness for Nordstein applications: the Autofac-backed
            BaseTest&lt;TModule&gt; fixture, container/service-provider helpers, the
            AwesomeAssertions + NSubstitute baseline every test project builds on, and shared
            fakes (a manual clock, scripted and network-refusing HTTP handlers, a recording logger,
            a throwaway certificate authority), an architecture fence kit and the dependency-free
            performance-budget harness.
        </Description>
        <PackageTags>nordstein;testing;mstest;autofac;nsubstitute</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nordstein.Core.Testing.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Autofac" Version="9.3.4" />
      <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
      <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
      <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
      <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
      <PackageReference Include="NSubstitute" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Nordstein.Core.Common\Nordstein.Core.Common.csproj" />
    </ItemGroup>

</Project>
