<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSTEST0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <!-- The full hosting package (not just Abstractions): HostingServiceCollectionExtensionsTests
             builds a real IHost to exercise the framework's own BackgroundService fault handling. -->
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Nordstein.Core.Common\Nordstein.Core.Common.csproj" />
      <!-- SeededRandomIsNotUsedForSecretsTests scans every production package of the solution. -->
      <ProjectReference Include="..\Nordstein.Core.AI\Nordstein.Core.AI.csproj" />
      <ProjectReference Include="..\Nordstein.Core.Domain\Nordstein.Core.Domain.csproj" />
      <ProjectReference Include="..\Nordstein.Core.Licensing\Nordstein.Core.Licensing.csproj" />
      <ProjectReference Include="..\Nordstein.Core.Storage\Nordstein.Core.Storage.csproj" />
      <ProjectReference Include="..\Nordstein.Core.Testing\Nordstein.Core.Testing.csproj" />
    </ItemGroup>

</Project>
