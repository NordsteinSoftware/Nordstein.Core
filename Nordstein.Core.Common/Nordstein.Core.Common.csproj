<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            Product-agnostic building blocks shared across Nordstein applications: clock and
             randomness seams, async primitives, validation helpers, type conversion, security
             contracts, AEAD cryptography, durable file IO, Autofac registration helpers, and
             background-service hosting defaults.
        </Description>
        <PackageTags>nordstein;autofac;dependency-injection;utilities</PackageTags>
        <!-- Required only by the source-generated LibraryImport marshalling stub for the single
             libc directory-fsync interop in Io/Internal/NativeFileApi.cs. No hand-written unsafe
             code exists in this assembly. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nordstein.Core.Common.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Autofac" Version="9.3.2" />
      <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
      <!-- Abstractions carries IHostedService/BackgroundService; HostOptions (which
           AddResilientBackgroundServices configures) lives in the full hosting package. -->
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    </ItemGroup>

</Project>
