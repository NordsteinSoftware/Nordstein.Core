# Nordstein.Core — editor/formatter configuration.
# Directory.Build.props turns the severities below into build failures (EnforceCodeStyleInBuild
# with TreatWarningsAsErrors). `root = true` seals the chain, as Directory.Build.props and
# Directory.Build.targets seal theirs: a consuming product's .editorconfig never reaches Core
# projects, so Core builds the same inside a product as standalone. See docs/code-style.md.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
tab_width = 4

# File-scoped namespaces are the one blessed form.
csharp_style_namespace_declarations = file_scoped:error

# var only when the type is apparent from the right-hand side; explicit types otherwise.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members are allowed but never mandated.
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:silent

# Braces are always required: no single-line `if` without braces.
csharp_prefer_braces = true:error

# `this.` is redundant; the compiler already scopes members.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Modifier order and readonly-when-possible are mechanical, not a review nit.
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:error
dotnet_style_readonly_field = true:warning

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
