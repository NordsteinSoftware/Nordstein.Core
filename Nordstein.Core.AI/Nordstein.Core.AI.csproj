<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            Product-agnostic AI foundations for Nordstein applications: LLM message and
            conversation types, tool specifications, prompt templates, completions and token
            usage, model parameters, the agent and model-client contracts, and structured
            model-output parsing.
        </Description>
        <PackageTags>nordstein;ai;llm;agent;prompt</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.3.2" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <!-- BinaryData: the payload envelope of binary message content parts. Microsoft-owned
             BCL-extension package; the alternative (raw byte[] + media-type pairs) would fork
             the moved contract for no gain. -->
        <PackageReference Include="System.Memory.Data" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nordstein.Core.Common\Nordstein.Core.Common.csproj" />
        <ProjectReference Include="..\Nordstein.Core.Domain\Nordstein.Core.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nordstein.Core.AI.Tests" />
    </ItemGroup>

</Project>
